# Redirections permanentes des anciennes URLs (hébergement Apache / OVH)
RewriteEngine On
ErrorDocument 404 /404.html
RedirectMatch 301 ^/nos-references/?$ /references
RedirectMatch 301 ^/convertisseur-taille-ecran/?$ /outils/convertisseur-taille-ecran
RedirectMatch 301 ^/solutions/affichage-dynamique/magasins/?$ /secteurs/retail
RedirectMatch 301 ^/solutions/affichage-dynamique/vitrines/?$ /secteurs/retail
RedirectMatch 301 ^/solutions/affichage-dynamique/corporate/?$ /secteurs/corporate
RedirectMatch 301 ^/solutions/salles-de-reunion/?$ /solutions/salles-de-reunion-visioconference
RedirectMatch 301 ^/solutions/salles-de-reunion/solutions-audiovisuelles/?$ /solutions/salles-de-reunion-visioconference
RedirectMatch 301 ^/solutions/salles-de-classe/?$ /secteurs/education
RedirectMatch 301 ^/solutions/salles-de-classe/solutions-pedagogiques/?$ /secteurs/education
RedirectMatch 301 ^/solutions/ecrans-interactifs/?$ /solutions/ecrans-tactiles-interactifs
RedirectMatch 301 ^/solutions/solutions-audiovisuelles/?$ /solutions/salles-de-reunion-visioconference

# Cache long pour les ressources versionnées
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
