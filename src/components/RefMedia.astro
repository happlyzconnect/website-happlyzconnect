---
// Visuel d'une référence : la photo du chantier si elle existe, sinon un visuel neutre (icône du type de prestation).
import Photo from './Photo.astro';
import Icon from './Icon.astro';
interface Props { image: string | null; client: string; category: string }
const { image, client, category } = Astro.props;
const icon = category === 'salle-classe' ? 'graduation' : category === 'affichage-dynamique' ? 'signage' : 'video';
---
{image ? (
  <div class="card__media"><Photo name={image} folder="refs" alt={`Réalisation HAPPLYZ Connect — ${client}`} /></div>
) : (
  <div class="card__media ref-ph" aria-hidden="true"><Icon name={icon} /><span>{client.split(' — ')[0]}</span></div>
)}
<style>
  .ref-ph { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; background: linear-gradient(135deg, var(--navy) 0%, #1d3a6b 100%); color: #fff; }
  .ref-ph :global(svg) { width: 46px; height: 46px; color: var(--cyan); }
  .ref-ph span { font-weight: 700; font-size: 1.05rem; text-align: center; padding: 0 16px; }
</style>
