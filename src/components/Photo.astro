---
// Affiche une image du dossier src/assets (photos, refs, logos, partners) par son nom,
// optimisée automatiquement (WebP, tailles responsives).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  folder?: 'photos' | 'refs' | 'logos' | 'partners';
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'auto';
  format?: 'webp' | 'png';
}
const { name, folder = 'photos', alt, widths = [480, 800, 1200], sizes = '(max-width: 640px) 100vw, 400px', class: cls, loading = 'lazy', fetchpriority, format = 'webp' } = Astro.props;

const all = import.meta.glob<{ default: ImageMetadata }>('/src/assets/{photos,refs,logos,partners}/*.{jpg,png}', { eager: true });
const key = Object.keys(all).find((k) => k.includes(`/${folder}/${name}.`));
if (!key) throw new Error(`Image introuvable : ${folder}/${name}`);
const src = all[key].default;
const w = widths.filter((x) => x <= src.width);
const finalWidths = w.length ? w : [src.width];
---
<Image src={src} alt={alt} widths={finalWidths} sizes={sizes} class={cls} loading={loading} fetchpriority={fetchpriority} format={format} quality={78} />
