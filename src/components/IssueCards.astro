---
import Icon from './Icon.astro';
import type { Card } from '../data/site';
interface Props { eyebrow?: string; title: string; text?: string; items: Card[] }
const { eyebrow = 'Vos enjeux', title, text, items } = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <div><span class="eyebrow">{eyebrow}</span><h2>{title}</h2></div>
      {text && <p>{text}</p>}
    </div>
    <div class={`grid ${items.length === 4 ? 'grid-4' : 'grid-3'}`}>
      {items.map((it) => (
        <div class="card card--plain reveal">
          <Icon name={it.icon} class="card__icon" />
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
