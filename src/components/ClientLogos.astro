---
import Photo from './Photo.astro';
import data from '../data/references.json';
interface Props { title?: string; text?: string }
const { title = 'Des entreprises et établissements qui nous font confiance.', text = 'Grands comptes, établissements scolaires, réseaux de magasins : ils nous ont confié leurs projets audiovisuels.' } = Astro.props;
---
<section class="section section--tight">
  <div class="container">
    <div class="section-head reveal">
      <div><span class="eyebrow">Ils nous font confiance</span><h2>{title}</h2></div>
      <p>{text}</p>
    </div>
    <ul class="logos reveal">
      {data.clients.map((c) => (
        <li title={c.name}><Photo name={c.logo} folder="logos" alt={c.name} widths={[240]} sizes="140px" format="png" /></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .logos { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 30px 40px; --cols: 6; }
  .logos li { flex: 0 0 calc((100% - (var(--cols) - 1) * 40px) / var(--cols)); min-width: 0; display: flex; justify-content: center; align-items: center; height: 64px; }
  .logos :global(img) { max-height: 64px; max-width: min(140px, 100%); width: auto; height: auto; object-fit: contain; filter: grayscale(1); opacity: 0.75; transition: all 0.2s; }
  .logos li:hover :global(img) { filter: none; opacity: 1; }
  @media (max-width: 1100px) { .logos { --cols: 5; } }
  @media (max-width: 900px) { .logos { --cols: 4; } }
  @media (max-width: 560px) { .logos { --cols: 3; gap: 20px; } .logos li { flex-basis: calc((100% - 40px) / 3); } }
</style>
