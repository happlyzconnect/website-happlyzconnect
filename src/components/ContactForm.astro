---
// Formulaire envoyé via EmailJS (même compte et mêmes modèles que l'ancien site).
import Icon from './Icon.astro';
import { emailjs } from '../data/site';
interface Props { variant?: 'contact' | 'signage' }
const { variant = 'contact' } = Astro.props;
const isSignage = variant === 'signage';
---
<form class="form contact-form" data-variant={variant} data-service={emailjs.serviceId} data-template={emailjs.contactTemplate} data-key={emailjs.publicKey} novalidate>
  {!isSignage && (
    <fieldset class="field" style="border:0;padding:0;margin:0">
      <legend>Votre demande</legend>
      <div class="choice-row">
        <label class="choice"><input type="radio" name="request_type" value="Demande de devis" checked /><span>Demande de devis</span></label>
        <label class="choice"><input type="radio" name="request_type" value="Demande d'information" /><span>Information</span></label>
        <label class="choice"><input type="radio" name="request_type" value="Autre demande" /><span>Autre</span></label>
      </div>
    </fieldset>
  )}
  <div class="form-row">
    <div class="field"><label for={`${variant}-last`}>Nom *</label><input id={`${variant}-last`} name="last_name" autocomplete="family-name" required /></div>
    <div class="field"><label for={`${variant}-first`}>Prénom</label><input id={`${variant}-first`} name="first_name" autocomplete="given-name" /></div>
  </div>
  <div class="field"><label for={`${variant}-company`}>{isSignage ? 'Entreprise / Établissement *' : 'Société / Établissement *'}</label><input id={`${variant}-company`} name="company_name" autocomplete="organization" required /></div>
  <div class="form-row">
    <div class="field"><label for={`${variant}-email`}>Email *</label><input id={`${variant}-email`} type="email" name="from_email" autocomplete="email" required /></div>
    <div class="field"><label for={`${variant}-phone`}>Téléphone</label><input id={`${variant}-phone`} type="tel" name="phone" autocomplete="tel" /></div>
  </div>
  <div class="field"><label for={`${variant}-msg`}>{isSignage ? 'Votre besoin (optionnel)' : 'Votre message *'}</label><textarea id={`${variant}-msg`} name="message" required={!isSignage} placeholder={isSignage ? 'Nombre d’écrans, de sites, usages envisagés…' : 'Décrivez votre projet : type de salles, nombre d’écrans, délais…'}></textarea></div>
  <div class="hp" aria-hidden="true"><label>Ne pas remplir<input name="website" tabindex="-1" autocomplete="off" /></label></div>
  <p class="form-legal">En envoyant ce formulaire, vous acceptez que vos informations soient utilisées pour répondre à votre demande. <a href="/politique-de-confidentialite">Politique de confidentialité</a>.</p>
  <div class="form-status" role="status" aria-live="polite"></div>
  <button type="submit" class={`btn ${isSignage ? 'btn--orange' : 'btn--primary'}`}>{isSignage ? 'Demander une démonstration' : 'Envoyer ma demande'} <Icon name="arrow" /></button>
</form>

<style>
  .form-legal { font-size: 0.78rem; color: var(--muted); margin: 0; }
  .form-legal a { text-decoration: underline; }
  .contact-form .btn { justify-self: start; }
  .contact-form .btn[disabled] { opacity: 0.6; cursor: wait; }
</style>

<script>
  const params = new URLSearchParams(location.search);
  document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
    const variant = form.dataset.variant;
    // Pré-remplissage depuis l'URL (?demande=info|devis, ?config=... depuis le configurateur)
    const demande = params.get('demande');
    if (demande === 'info') (form.querySelector('input[value="Demande d\'information"]') as HTMLInputElement | null)?.click();
    const config = params.get('config');
    const msg = form.querySelector('textarea') as HTMLTextAreaElement;
    if (config && msg && variant === 'contact') msg.value = `Configuration préparée avec le configurateur de salle :\n${config}\n\n`;

    const status = form.querySelector('.form-status') as HTMLElement;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const show = (ok: boolean, text: string) => { status.className = `form-status ${ok ? 'is-ok' : 'is-err'}`; status.textContent = text; };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      if (fd.get('website')) return; // robot
      const required = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]'));
      const missing = required.find((f) => !f.value.trim());
      if (missing) { show(false, 'Merci de remplir les champs obligatoires (*).'); missing.focus(); return; }
      const email = String(fd.get('from_email'));
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { show(false, 'L’adresse email semble incorrecte.'); return; }

      btn.disabled = true;
      const params = {
        to_email: 'contact@happlyz.com',
        company_name: fd.get('company_name') || '',
        last_name: fd.get('last_name') || '',
        first_name: fd.get('first_name') || '',
        from_email: email,
        phone: fd.get('phone') || '',
        message: fd.get('message') || '',
        request_type: variant === 'signage' ? 'Démonstration HAPPLYZ Signage' : fd.get('request_type') || 'Demande de devis',
      };
      try {
        const res = await fetch('https://api.emailjs.com/api/v1.0/email/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ service_id: form.dataset.service, template_id: form.dataset.template, user_id: form.dataset.key, template_params: params }),
        });
        if (!res.ok) throw new Error(await res.text());
        form.reset();
        show(true, 'Merci, votre demande a bien été envoyée. Nous revenons vers vous très rapidement.');
      } catch {
        show(false, 'L’envoi a échoué. Vous pouvez nous écrire directement à contact@happlyz.com ou nous appeler au 01 85 39 01 67.');
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
