---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { company } from '../data/site';
---
<Base
  title="Contact et demande de devis"
  description="Contactez HAPPLYZ Connect pour votre projet audiovisuel : salles de réunion, visioconférence, affichage dynamique, écrans interactifs. Devis gratuit."
  breadcrumbs={[{ label: 'Contact', href: '/contact' }]}
>
  <section class="page-head">
    <div class="container">
      <ol class="breadcrumb breadcrumb--dark"><li><a href="/">Accueil</a></li><li><span aria-current="page">Contact</span></li></ol>
      <h1>Parlons de votre projet.</h1>
      <p class="lead">Une question, un besoin de devis, une salle à équiper ? Nos experts vous répondent rapidement.</p>
    </div>
  </section>
  <section class="section" style="padding-top:40px">
    <div class="container contact">
      <div class="card contact__form"><ContactForm /></div>
      <aside class="contact__aside">
        <div class="card card--plain">
          <h2 class="h3">Nos coordonnées</h2>
          <ul class="contact__list">
            <li><Icon name="phone" /><div><strong><a href={`tel:${company.phoneIntl}`}>{company.phone}</a></strong><span>Du lundi au vendredi, 9 h – 18 h</span></div></li>
            <li><Icon name="mail" /><div><strong><a href={`mailto:${company.email}`}>{company.email}</a></strong><span>Pour toute demande écrite</span></div></li>
            <li><Icon name="map" /><div><strong>{company.street}</strong><span>{company.postalCode} {company.city}</span></div></li>
          </ul>
        </div>
        <div class="card card--plain">
          <h2 class="h3">Plaquette commerciale</h2>
          <p>Notre offre en quelques pages, à partager en interne.</p>
          <a href="/plaquette-commerciale-happlyz.pdf" class="link-arrow" download>Télécharger la plaquette (PDF) <Icon name="download" /></a>
        </div>
      </aside>
    </div>
  </section>
</Base>
<style>
  .contact { display: grid; grid-template-columns: 1.6fr 1fr; gap: 28px; align-items: start; }
  .contact__form { padding: 32px; }
  .contact__aside { display: grid; gap: 22px; }
  .h3 { font-size: 1.15rem; }
  .contact__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 18px; }
  .contact__list li { display: flex; gap: 14px; }
  .contact__list :global(svg) { width: 22px; height: 22px; color: var(--link); flex: none; margin-top: 2px; }
  .contact__list span { display: block; color: var(--muted); font-size: 0.9rem; }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } .contact__form { padding: 22px; } }
</style>
