---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import IssueCards from '../../components/IssueCards.astro';
import PhotoCards from '../../components/PhotoCards.astro';
import BuildRun from '../../components/BuildRun.astro';
import RefCards from '../../components/RefCards.astro';
import CtaBand from '../../components/CtaBand.astro';
import SignageBand from '../../components/SignageBand.astro';
import Icon from '../../components/Icon.astro';
import ConseilCards from '../../components/ConseilCards.astro';
import ZoneChips from '../../components/ZoneChips.astro';
import { sectors, type Sector } from '../../data/site';

export function getStaticPaths() {
  return sectors.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Sector };
const crumbs = [{ label: 'Secteurs', href: `/secteurs/${sectors[0].slug}` }, { label: s.title, href: `/secteurs/${s.slug}` }];
---
<Base title={s.metaTitle} description={s.metaDescription} breadcrumbs={crumbs} ogPhoto={s.photo} schema={[{
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.metaTitle,
  serviceType: 'Intégration audiovisuelle',
  description: s.metaDescription,
  url: `https://www.happlyzconnect.com/secteurs/${s.slug}`,
  provider: { '@id': 'https://www.happlyzconnect.com/#organisation' },
  areaServed: [{ '@type': 'AdministrativeArea', name: 'Île-de-France' }, { '@type': 'Country', name: 'France' }],
  audience: { '@type': 'Audience', audienceType: s.kicker },
}]}>
  <Hero
    photo={s.photo}
    photoAlt={`Équipement audiovisuel — secteur ${s.title}`}
    breadcrumbs={crumbs}
    kicker={s.kicker}
    title={s.title}
    sub={s.heroTitle}
    text={s.heroText}
    primary={{ label: s.cta, href: '/contact?demande=devis' }}
    secondary={{ label: 'Voir nos réalisations', href: '#realisations' }}
  />

  <IssueCards title={s.issuesTitle} text={s.issuesText} items={s.issues} />

  <PhotoCards title={s.solutionsTitle} items={s.solutions} />

  {s.slug === 'retail' && (
    <section class="section">
      <div class="container">
        <div class="section-head reveal">
          <div><span class="eyebrow">Une gestion simplifiée de vos contenus</span><h2>De la création à l’affichage, en toute simplicité.</h2></div>
        </div>
        <ol class="steps">
          <li class="card card--plain reveal"><Icon name="monitor" class="card__icon" /><h3>1. Contenus créés</h3><p>Visuels, vidéos et messages, planifiés depuis une interface simple.</p></li>
          <li class="card card--plain reveal"><Icon name="cloud" class="card__icon" /><h3>2. Diffusés à distance</h3><p>Les contenus sont envoyés en toute sécurité vers vos écrans.</p></li>
          <li class="card card--plain reveal"><Icon name="store" class="card__icon" /><h3>3. Affichés en magasin</h3><p>Vos écrans se mettent à jour automatiquement, dans un ou plusieurs magasins.</p></li>
        </ol>
      </div>
    </section>
  )}

  {s.slug === 'retail' && <SignageBand />}

  <BuildRun eyebrow="Un accompagnement complet" title={s.accompTitle} build={s.build} run={s.run} soft={s.slug !== 'retail'} />

  {s.slug === 'education' && (
    <section class="section section--tight">
      <div class="container">
        <a href="/marches-publics" class="mp-band reveal">
          <div><span class="eyebrow">Acheteurs publics</span><h2>Une consultation ou un marché public ?</h2><p>MAPA, appels d’offres, visite de site, installation pendant les vacances scolaires : découvrez notre accompagnement des établissements publics.</p></div>
          <span class="btn btn--primary btn--sm">Marchés publics et établissements scolaires <Icon name="arrow" /></span>
        </a>
      </div>
    </section>
  )}

  <div id="realisations">
    <RefCards ids={s.refIds} title={s.refTitle} soft={s.slug === 'retail'} />
  </div>

  <ConseilCards solution={({ corporate: 'salles-de-reunion-visioconference', education: 'ecrans-tactiles-interactifs', retail: 'affichage-dynamique' } as Record<string, string>)[s.slug]} soft={s.slug !== 'retail'} />

  <ZoneChips />

  <CtaBand eyebrow="Un projet ?" title={`${s.cta}.`} label={s.cta} photo={s.photo} />
</Base>

<style>
  .mp-band { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding: 28px 32px; border-radius: var(--radius); background: var(--orange-soft); border: 1px solid #f6dfae; }
  .mp-band h2 { font-size: clamp(1.3rem, 2.2vw, 1.7rem); margin: 6px 0 8px; }
  .mp-band p { margin: 0; color: var(--muted); max-width: 640px; }
  .mp-band .btn { white-space: normal; max-width: 100%; }
  @media (max-width: 640px) { .mp-band { padding: 22px; } }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; counter-reset: s; }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr; } }
</style>
