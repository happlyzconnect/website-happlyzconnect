---
import Base from '../layouts/Base.astro';
---
<Base title="Mentions légales" description="Mentions légales de HAPPLYZ Connect : éditeur du site, hébergement, propriété intellectuelle et protection des données personnelles." breadcrumbs={[{ label: 'Mentions légales', href: '/mentions-legales' }]}>
  <section class="page-head">
    <div class="container">
      <ol class="breadcrumb breadcrumb--dark"><li><a href="/">Accueil</a></li><li><span aria-current="page">Mentions légales</span></li></ol>
      <h1>Mentions légales</h1>
    </div>
  </section>
  <section class="section" style="padding-top:40px">
    <div class="container prose">
<div>
          <section>
            <h2>1. Informations légales</h2>
            <p>
              Le site www.happlyzconnect.com est édité par la société HAPPLYZ Connect, Société par Actions Simplifiée au capital de 30.000€.
            </p>
            <ul>
              <li>Siège social : 5 rue Charles Despeaux 78400 CHATOU</li>
              <li>SIREN : 823 127 154</li>
              <li>RCS : VERSAILLES</li>
              <li>Téléphone : 01 85 39 01 67</li>
              <li>Email : contact@happlyz.com</li>
            </ul>
